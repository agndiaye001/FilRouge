pipeline {
    agent any
    environment {
        DOCKER_COMPOSE_FILE = 'FilRouge/backend/docker-compose.yaml'
    }
    stages {
        stage('List Files') {
            steps {
                // Liste les fichiers du répertoire
                sh 'ls -la FilRouge/backend'
                sh 'cat ${DOCKER_COMPOSE_FILE} '
            }
        }
        stage('Build Docker Compose') {
            steps {
                script {
                    // Vérifie si le répertoire existe
                    if (!fileExists('FilRouge/backend')) {
                        error "Le répertoire 'FilRouge/backend' est introuvable."
                    }
                    // Lance le build avec docker-compose
                    sh 'docker compose -f ${DOCKER_COMPOSE_FILE} up --build -d'
                }
            }
        }
        stage('Release') {
            steps {
                script {
                    // Génère un numéro de version en fonction de la date ou d'autres paramètres
                    RELEASE_VERSION = "v1.0.${env.BUILD_NUMBER}"
                    echo "Creating Release: ${RELEASE_VERSION}"

                    // Crée un tag Git pour la release
                    sh """
                    git config --global user.name "angdiaye001"
                    git config --global user.email "mamindiaye0101@gmail.com"
                    git tag -a ${RELEASE_VERSION} -m "Release ${RELEASE_VERSION}"
                    git push https://agndiaye001:Douleplus01&@github.com/agndiaye001/FilRouge.git ${RELEASE_VERSION}
                    """


                    sh "git tag"
                    sh "git ls-remote --tags origin"

                    // Publier un artefact ou une release (exemple pour GitHub)
                    // Vous pouvez ajouter des étapes pour télécharger des fichiers à une plateforme comme GitHub, Nexus ou Artifactory.
                }
            }
        }
        stage('Cleanup') {
            steps {
                // Arrête et nettoie les conteneurs, réseaux et volumes
                sh 'docker-compose -f ${DOCKER_COMPOSE_FILE} down'
            }
        }
        
    }
    post {
        failure {
            echo 'Une erreur est survenue pendant le pipeline.'
        }
        always {
            echo 'Pipeline terminé.'
        }
    }
}
