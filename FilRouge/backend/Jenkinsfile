pipeline {
    agent any
    environment {
        DOCKER_COMPOSE_FILE = 'FilRouge/backend/docker-compose.yaml'
    }
    stages {
        stage('List Files') {
            steps {
                // Liste les fichiers du répertoire
                sh 'ls -la FilRouge/backend'
                sh 'cat ${DOCKER_COMPOSE_FILE} '
            }
        }
        stage('Build Dockerfile') {
            steps {
                script {
                    // Construire l'image Docker à partir du Dockerfile
                    def customImage = docker.build('filrouge-backend', 'FilRouge/backend')
                }
            }
        }
        stage('Build Docker Compose') {
            steps {
                script {
                    // Vérifie si le répertoire existe
                    if (!fileExists('FilRouge/backend')) {
                        error "Le répertoire 'FilRouge/backend' est introuvable."
                    }
                    // Lance le build avec docker-compose
                    sh 'docker-compose -f ${DOCKER_COMPOSE_FILE} up --build -d'
                }
            }
        }
        stage('Run Tests') {
            steps {
                // Exécute les tests définis dans le service Docker Compose
                sh 'docker-compose -f ${DOCKER_COMPOSE_FILE} run test'
            }
        }
        stage('Cleanup') {
            steps {
                // Arrête et nettoie les conteneurs, réseaux et volumes
                sh 'docker-compose -f ${DOCKER_COMPOSE_FILE} down'
            }
        }
    }
    post {
        failure {
            echo 'Une erreur est survenue pendant le pipeline.'
        }
        always {
            echo 'Pipeline terminé.'
        }
    }
}
